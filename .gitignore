# Dependency installs (keep bun.lock and other intentional lockfiles)
node_modules/

# Vite / TanStack Start / Nitro output and caches
/dist/
/dist-ssr/
/.output/
/.vinxi/
/.tanstack/
/.nitro/
*.tsbuildinfo

# Optional Bun/Node test coverage output
/coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local environment files; examples remain versionable
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template

# Wrangler local state and secrets
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
!.dev.vars.*.example

# Local editor and operating-system files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
